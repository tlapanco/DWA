@{
    Layout = "MasterPanelPage";
    ViewBag.Title = "Panel autos";
}

<!-- Contenido del panel autos -->
<div class="container">
    <!-- Tabla de registros -->
    <table>
        <thead>
            <tr>
                <th>Modelo</th>
                <th>Marca</th>
                <th>Precio</th>
                <th>Motor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody id="userTable">
        @foreach(var auto in Model)
        {
            <tr>
                <td>@auto.Modelo</td>
                <td>@auto.Marca</td>
                <td>@string.Format("{0:c}", @auto.Precio)</td>
                <td>@auto.Motor</td>
                <td class="btn-group">
                <form action="/Login/BorrarAuto" method="POST">
                    <input type="hidden" name="idAuto" value="@auto.ID" />
                    <button type="submit" class="btn btn-delete">Eliminar</button>
                </form>
                <button class="btn btn-edit" onclick='mostrarModalEditar(@Html.Raw(Json.Serialize(auto)))'>Editar</button>
                </td>
            </tr>
        }

        </tbody>
    </table>
</div>

<!-- Modal Editar Auto -->
<div id="editarAutoModal" class="modal-overlay">
    <div class="modal-container">
        <div class="modal-header">
            <h3>Editar Auto</h3>
            <button class="close-btn" onclick="cerrarModal()">×</button>
        </div>
        <div class="modal-body">
            <!-- Formulario para editar el auto -->
            <form id="formEditarAuto" action="/Login/EditarAuto" method="POST">
                <label for="modelo">Modelo:</label>
                <input type="text" id="modelo" name="modelo" required>
                
                <label for="marca">Marca:</label>
                <input type="text" id="marca" name="marca" required>
                
                <label for="precio">Precio:</label>
                <input type="number" id="precio" name="precio" required>
                
                <label for="motor">Motor:</label>
                <input type="text" id="motor" name="motor" required>

                <label for="imagen">Imagen:</label>
                <input type="text" id="imagen" name="imagen" required>

                <label for="descripcion">Descripcion:</label>
                <textarea id="descripcion" name="descripcion" required></textarea>
                
                
                <input type="hidden" id="idAuto" name="idAuto" />
            </form>
        </div>
        <div class="modal-footer">
            <button form="formEditarAuto" class="btn-save">Guardar cambios</button>
            <button class="btn-cancel" onclick="cerrarModal()">Cancelar</button>
        </div>
    </div>
</div>


<script>
const modalEditarAuto = document.getElementById('editarAutoModal');


function mostrarModalEditar (auto){
    /*Asignar los valores a los campos del formulario*/
    document.getElementById('modelo').value = auto.modelo;
    document.getElementById('marca').value = auto.marca;
    document.getElementById('precio').value = auto.precio;
    document.getElementById('motor').value = auto.motor;
    document.getElementById('imagen').value = auto.imagen;
    document.getElementById('descripcion').value = auto.descripcion;
    document.getElementById('idAuto').value = auto.id;

    modalEditarAuto.style.display = 'flex';    
}

function cerrarModal() {
    modalEditarAuto.style.display = 'none';
}
</script>
