@{
    Layout = "MasterLoginPage";
    ViewBag.Title = "Inicio de sesión";
}
<div class="form-container">
    <h2>Iniciar sesión</h2>
    <form action="@Url.Action("Index", "Login")" method="POST">
      <label for="idUsuario">ID Usuario</label>
      <input type="text" id="idUsuario" name="idUsuario" required />

      <label for="contrasena">Contraseña</label>
      <input type="password" id="contrasena" name="contrasena" required />

      <button type="submit">Iniciar Sesión</button>
    </form>
    <div class="footer">
      ¿No tienes una cuenta? <a href="#" style="color:#667eea; text-decoration:none;">Registrate</a>
    </div>
  </div>