<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - Panel Administración</title>
	<link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />	
</head>
<body>
	<header>
    	<h1>Gestión de Autos - @ViewData["Usuario"]</h1>
    	<a asp-controller="Login" asp-action="CerrarSesion" >Salir</a>
	</header>
	
	<main role="main">
		@RenderBody()
	</main>
</body>
</html>
