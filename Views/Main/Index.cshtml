@model List<Auto>
@{

	ViewBag.Title = "Sesión 5";
	
}

<section class="seccion-principal">
	<h1>Emblema Motors</h1>

	<p>Emblema Motors es una empresa líder en la venta de vehículos,dedicada
	a ofrecer una experiencia de compra excepcional y personalizada para cada cliente. Fundada con la visión de redefinir el mercado automotriz, 
	Emblema Motors se especializa en la comercialización de automóviles, camionetas, 
	y motocicletas de alta calidad, abarcando tanto marcas reconocidas como opciones 
	exclusivas para aquellos que buscan un estilo único.</p>

	<img class="IMG" src="/img/CardIMG.jpg" />
</section>

<section class="seccion-secundaria">
	<h2>Autos Diponibles</h2>

	<p class="descripcion">Descubre los mejores autos en el mercado, disponibles en una amplia 
	variedad de modelos y estilos para cada necesidad y gusto. Ya sea 
	que busques la potencia de un motor deportivo, la elegancia de un 
	sedán premium, o la versatilidad de un SUV para toda la familia, 
	encontrarás opciones de última generación, equipadas con tecnología 
	avanzada y máxima eficiencia. </p>

	<section class="contenedor-vehiculos">
		@foreach(var auto in Model)
		{
			<div class="tarjeta-vehiculo">
				<img src="/img/autos/@auto.Imagen" alt="Imagen de " />
				<div class="tarjeta-vehiculo-contenido">
					<p class="tarjeta-vehiculo-titulo">@auto.Modelo</p>
					<p class="tarjeta-vehiculo-descripcion">@auto.Descripcion</p>
					<ul class="tarjeta-vehiculo-descripcion">
						<li>Marca: @auto.Marca</li>
						<li>Motor: @auto.Motor</li>
						<li>Precio: $@auto.Precio</li>
					</ul>
				</div>
			</div>	
		}
	</section>

</section>

<section class="seccion-secundaria">
	<h2>Nuestros proveedores</h2>

	<section class="contenedor-proveedores">
		<div class="proveedor-tarjeta">
			<img class="proveedor-tarjeta-imagen" src="/img/Proveedores/audi.png" alt="Audi" />
			<p class="proveedor-tarjeta-descripcion">Nuestro proveedor #1 de automoviles Seat verificados y de alta gama.</p>
		</div>

		<div class="proveedor-tarjeta">
			<img class="proveedor-tarjeta-imagen" src="/img/Proveedores/volkswagen.png" alt="Volkswagen"/>
			<p class="proveedor-tarjeta-descripcion">Nuestro proveedor #1 de automoviles Seat verificados y de alta gama.</p>
		</div>

		<div class="proveedor-tarjeta">
			<img class="proveedor-tarjeta-imagen" src="/img/Proveedores/seat.png" alt="Seat" />
			<p class="proveedor-tarjeta-descripcion">Nuestro proveedor #1 de automoviles Seat verificados y de alta gama.</p>
		</div>
	</section>
</section>